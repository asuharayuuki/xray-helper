<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Collapsible Large Header (Android Settings Style) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:title="Edit item"
            app:titleCollapseMode="fade"
            app:expandedTitleTextAppearance="?attr/textAppearanceHeadlineLarge"
            app:collapsedTitleTextAppearance="?attr/textAppearanceTitleLarge"
            app:expandedTitleMarginStart="20dp"
            app:expandedTitleMarginBottom="16dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="40dp">

            <!-- Section 1: General Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_section_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Section name (e.g. Proxy, Actions)"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_section_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Item Title -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_item_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Item title"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_item_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Type Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Control type"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <RadioGroup
                        android:id="@+id/group_item_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Action button" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radio_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:text="Toggle switch" />

                    </RadioGroup>

                    <!-- Icon Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_item_icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Icon name"
                        app:helperText="shield, bug, terminal, wifi, key, bolt, lock, cafe, power, none"
                        app:helperTextEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_item_icon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Command Definitions (Unlimited Height) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commands"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- On / Trigger Command -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_on_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Trigger / On command"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_on_cmd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:typeface="monospace"
                            android:inputType="textMultiLine" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Off Command (Only visible for switch) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_off_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Off command"
                        android:visibility="gone"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_off_cmd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:typeface="monospace"
                            android:inputType="textMultiLine" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- State Check Command (Only visible for switch) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_state_check_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="State check command (exit 0 = ON)"
                        android:visibility="gone"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_state_check_cmd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:typeface="monospace"
                            android:inputType="textMultiLine" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Dynamic Summary Command -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_summary_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Dynamic summary command (stdout output)"
                        app:helperText="Leave empty to display no subtitle description"
                        app:helperTextEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_summary_cmd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:typeface="monospace"
                            android:inputType="textMultiLine" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Disable Condition Command -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_disable_condition_cmd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Disable condition command (exit 0 = Disabled)"
                        app:helperText="When exit code is 0, this row is disabled"
                        app:helperTextEnabled="true"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_disable_condition_cmd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:typeface="monospace"
                            android:inputType="textMultiLine" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Item Button (Hidden for Core) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_item"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Delete item"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorError"
                app:iconGravity="textStart"
                app:cornerRadius="16dp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
