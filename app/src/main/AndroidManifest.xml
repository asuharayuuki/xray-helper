<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Xray"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- MD3 Management Activity, opened by long-pressing Xray QS tile -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Xray">

            <!-- System QS tile long-press preference action -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Launcher action for desktop app icon -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/title_settings"
            android:exported="false"
            android:theme="@style/Theme.Xray" />

        <!-- Edit / Create Dashboard Item Activity -->
        <activity
            android:name=".EditItemActivity"
            android:label="@string/dialog_title_edit_item"
            android:exported="false"
            android:theme="@style/Theme.Xray" />

        <!-- Quick Settings Tile Service (Xray) -->
        <service
            android:name=".XrayTileService"
            android:label="@string/tile_label_normal"
            android:icon="@drawable/ic_xray"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">

            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />

            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />

        </service>

        <!-- Caffeine Background WakeLock Service -->
        <service
            android:name=".CaffeineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep screen awake (Caffeine)" />
        </service>

        <!-- Quick Settings Tile Service (Caffeine) -->
        <service
            android:name=".CaffeineTileService"
            android:label="@string/caffeine_tile_label"
            android:icon="@drawable/local_cafe_outline"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">

            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />

            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />

        </service>

        <!-- Quick Settings Tile Service (Record) -->
        <service
            android:name=".RecordTileService"
            android:label="@string/record_tile_label"
            android:icon="@drawable/ic_mic"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">

            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />

        </service>

    </application>

</manifest>
